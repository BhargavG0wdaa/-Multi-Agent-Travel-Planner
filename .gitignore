# ============================================================
#  Files git should NEVER track
# ============================================================

# Secrets — the #1 rule: never commit real API keys
.env

# Local database (user accounts) — never commit user data
*.db
data/

# Python virtual environment (huge, machine-specific — rebuild with `pip install -e .`)
.venv/

# Python bytecode cache
__pycache__/
*.pyc

# OS / editor junk
.DS_Store

# Build / install artifacts
*.egg-info/
dist/
build/

# Unused photos left over from the old landing page (only hero_van.jpg is used)
src/travel_planner/api/static/landing/*
!src/travel_planner/api/static/landing/hero_van.jpg
