# ============================================================
#  TEMPLATE — safe to commit (no real values here).
#  Copy this file to `.env` and paste your real keys there.
#  You only need ONE LLM key to start; everything else is optional.
# ============================================================

# ---- LLM providers (pick ONE) ----
# Claude — best reasoning.  https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq — free tier, great for learning.  https://console.groq.com
GROQ_API_KEY=

# ---- Optional external data (add later) ----
# Weather (OpenWeatherMap).  https://openweathermap.org/api
# (Note: Open-Meteo needs NO key at all, so you may never need this.)
OPENWEATHER_API_KEY=

# Flights (Amadeus free test tier).  https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
