# ============================================================
#  TEMPLATE — safe to commit (no real values here).
#  Copy this file to `.env` and paste your real keys there.
# ============================================================

# ---- Flights (Duffel) ----
# Free developer account, no card needed: https://app.duffel.com/join
# Use a TEST token (starts with duffel_test_) — test mode never books real tickets.
DUFFEL_ACCESS_TOKEN=

# ---- Login tokens (JWT) ----
# Signing key for login tokens. Required: a long random string. Changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Set to true when the site is served over HTTPS, so the login cookie is never sent over plain http.
COOKIE_SECURE=false

# ---- Database (local MySQL) ----
# The app connects as its own user with access only to its own database.
# Create both once as root, from scripts/mysql_setup.example.sql (see README).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=travel_planner
MYSQL_USER=travel_app
MYSQL_PASSWORD=
