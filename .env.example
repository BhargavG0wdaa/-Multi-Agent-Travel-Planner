# ---- Flights (Duffel) ----
# Free developer account, no card needed: https://app.duffel.com/join
# Use a TEST token (starts with duffel_test_) — test mode never books real tickets.
DUFFEL_ACCESS_TOKEN=

# ---- Web app ----
# Optional: a long random string used to sign login session cookies.
# Set it so logins survive server restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
